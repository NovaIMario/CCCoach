# Copy to .env and fill in. Everything is optional.

# Turns on AI hints (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 0 = disable the "Run" button (recommended for public deploys without Docker)
ENABLE_CODE_RUNNER=1

# Optional: Postgres (e.g. Supabase "Session pooler" connection string) holding Codeforces statements.
# Needed on Render, whose disk is wiped on each deploy. See HUMAN.md "Statements".
DATABASE_URL=
STATEMENT_REFRESH_HOURS=6
